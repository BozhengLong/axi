import {BusinessError} from "./src/domain/errors.ts";
import {openStore,seedStock} from "./src/storage/db.ts";
import {createApp} from "./src/http/app.ts";
import {mkdtempSync,rmSync,writeFileSync} from "node:fs";
import {join} from "node:path";
import type {Hooks} from "./src/domain/types.ts";
const directory=mkdtempSync("/tmp/orders-oracle-");
let seq=0;
const result:Record<string,unknown>={};
async function group(name:string,fn:()=>Promise<unknown>){try{result[name]=await fn();}catch(e){result[name]={error:String(e)};}}
const request=(key:string,quantity=1,sku="tea")=>new Request("http://localhost/orders",{method:"POST",headers:{"content-type":"application/json","Idempotency-Key":key},body:JSON.stringify({quantity,sku})});
const data=async(r:Response)=>({status:r.status,body:await r.json()});
function context(n=5,hooks:Hooks={}){const path=join(directory,`${++seq}.db`),db=openStore(path);seedStock(db,"tea",n);return {path,db,app:createApp(db,hooks),state:()=>({stock:(db.query("SELECT available FROM inventory WHERE sku='tea'").get() as any).available,orders:db.query("SELECT id,sku,quantity FROM orders ORDER BY id").all()})};}
function gate(n:number){let arrived=0,release!:()=>void;const p=new Promise<void>(r=>release=r);return async()=>{if(++arrived===n)release();await p;};}
async function command(args:string[],input?:string){const p=Bun.spawn(args,{stdin:input===undefined?"ignore":"pipe",stdout:"pipe",stderr:"pipe"});if(input!==undefined){p.stdin!.write(input);p.stdin!.end();}const timer=setTimeout(()=>p.kill("SIGKILL"),12000);try{return {code:await p.exited,out:await new Response(p.stdout).text(),err:await new Response(p.stderr).text()};}finally{clearTimeout(timer);}}
await group("basic",async()=>{const c=context(),s=Bun.serve({hostname:"127.0.0.1",port:0,fetch:c.app});try{const first=await data(await fetch(new URL("orders",s.url),{method:"POST",headers:{"Idempotency-Key":"first","content-type":"application/json"},body:JSON.stringify({sku:"tea",quantity:2})}));const stock=await data(await fetch(new URL("stock/tea",s.url))),orders=await data(await fetch(new URL("orders",s.url)));const cli=await command(["bun","src/cli.ts",c.path,"list"]);return {first,stock,orders,cli:{code:cli.code,value:JSON.parse(cli.out)},state:c.state()};}finally{s.stop(true);c.db.close();}});
await group("sameKey",async()=>{const c=context(50,{enter:gate(20)});try{const replies=await Promise.all(Array.from({length:20},()=>c.app(request("same",2)).then(data)));return {replies,state:c.state()};}finally{c.db.close();}});
await group("stockRace",async()=>{const c=context(5,{enter:gate(12)});try{const replies=await Promise.all(Array.from({length:12},(_,i)=>c.app(request(`key-${i}`)).then(data)));return {replies,state:c.state()};}finally{c.db.close();}});
await group("conflict",async()=>{const c=context(1);try{const a=await data(await c.app(request("same"))),b=await data(await c.app(request("same",2))),d=await data(await c.app(request("same",1,"other"))),replay=await data(await c.app(request("same")));return {a,b,d,replay,state:c.state()};}finally{c.db.close();}});
await group("rollback",async()=>{const out=[];for(const stage of ["after_inventory","after_order","before_commit"] as const){const c=context(5,{fail:s=>{if(s===stage)throw Error("injected");}});try{const failed=await data(await c.app(request("recover",2))),afterFailure=c.state();const recovered=await data(await createApp(c.db)(request("recover",2)));out.push({stage,failed,afterFailure,recovered,final:c.state()});}finally{c.db.close();}}return out;});
await group("invalid",async()=>{const c=context(1);try{const invalid=[];for(const q of [0,-1,1.5,9007199254740992])invalid.push(await data(await c.app(request("invalid",q))));const badJson=await data(await c.app(new Request("http://localhost/orders",{method:"POST",body:"{"})));const missing=await data(await c.app(new Request("http://localhost/orders",{method:"POST",body:JSON.stringify({sku:"tea",quantity:1})})));const failed=await data(await c.app(request("retry",2)));seedStock(c.db,"tea",3);const retry=await data(await c.app(request("retry",2)));return {invalid,badJson,missing,failed,retry,state:c.state()};}finally{c.db.close();}});
await group("restart",async()=>{const c=context(10),path=c.path;c.db.close();const worker=join(directory,"worker.ts");writeFileSync(worker,`import{openStore}from"/task/src/storage/db.ts";import{createApp}from"/task/src/http/app.ts";const db=openStore(process.argv[2]!);try{const r=await createApp(db)(new Request("http://localhost/orders",{method:"POST",headers:{"Idempotency-Key":"persist","content-type":"application/json"},body:JSON.stringify({sku:"tea",quantity:3})}));const body=await r.json();if(process.argv[3]!=="lost")console.log(JSON.stringify({status:r.status,body}));}finally{db.close();}`);
const first=await command(["bun",worker,path,"lost"]),second=await command(["bun",worker,path]),third=await command(["bun",worker,path]);const db=openStore(path);try{return {codes:[first.code,second.code,third.code],second:JSON.parse(second.out),third:JSON.parse(third.out),stock:db.query("SELECT available FROM inventory").get(),orders:db.query("SELECT * FROM orders").all()};}finally{db.close();}});
await group("crossProcess",async()=>{const out=[];for(const sameKey of [true,false]){const c=context(5),path=c.path;c.db.close();const worker=join(directory,`parallel-${sameKey}.ts`);writeFileSync(worker,`import{openStore}from"/task/src/storage/db.ts";import{createApp}from"/task/src/http/app.ts";const db=openStore(process.argv[2]!);try{const app=createApp(db,{enter:async()=>{console.log("READY");for await(const _ of Bun.stdin.stream())break;}});const r=await app(new Request("http://localhost/orders",{method:"POST",headers:{"Idempotency-Key":process.argv[3]!,"content-type":"application/json"},body:JSON.stringify({sku:"tea",quantity:3})}));console.log(JSON.stringify({status:r.status,body:await r.json()}));}finally{db.close();}`);
const children=Array.from({length:2},(_,i)=>Bun.spawn(["bun",worker,path,sameKey?"shared":`different-${i}`],{stdin:"pipe",stdout:"pipe",stderr:"pipe"}));
const readers=children.map(c=>c.stdout.getReader());const heads=await Promise.all(readers.map(r=>r.read()));for(let i=0;i<2;i++)if(!new TextDecoder().decode(heads[i]!.value).includes("READY"))throw Error("worker not ready");
for(const child of children){child.stdin.write("go\n");child.stdin.end();}
const replies=await Promise.all(children.map(async(child,i)=>{let text="";while(true){const part=await readers[i]!.read();if(part.done)break;text+=new TextDecoder().decode(part.value);}return {code:await child.exited,response:JSON.parse(text),stderr:await new Response(child.stderr).text()};}));
const db=openStore(path);try{out.push({sameKey,replies,stock:(db.query("SELECT available FROM inventory WHERE sku='tea'").get() as any).available,orders:db.query("SELECT id,sku,quantity FROM orders ORDER BY id").all()});}finally{db.close();}}
return out;});

await group("faultTypes",async()=>{const out=[];for(const stage of ["after_inventory","after_order","before_commit"] as const)for(const kind of ["error","business400","business409","string"]){const c=context(5,{fail:s=>{if(s!==stage)return;if(kind==="error")throw Error("failure");if(kind==="business400")throw new BusinessError(400,"invalid_request");if(kind==="business409")throw new BusinessError(409,"out_of_stock");throw "failure";}});try{const failed=await data(await c.app(request("retry",2))),afterFailure=c.state();const retry=await data(await createApp(c.db)(request("retry",2)));out.push({stage,kind,failed,afterFailure,retry,final:c.state()});}finally{c.db.close();}}return out;});
console.log(JSON.stringify(result));rmSync(directory,{recursive:true,force:true});
