import type { Database } from "bun:sqlite";
export function stock(db: Database, sku: string): number | undefined { return (db.query("SELECT available FROM inventory WHERE sku=?").get(sku) as {available:number}|null)?.available; }
export function subtract(db: Database, sku: string, quantity: number) { db.query("UPDATE inventory SET available=available-? WHERE sku=?").run(quantity, sku); }
