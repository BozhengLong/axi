import {Database} from "bun:sqlite";
import {migrate} from "./src/migrations/upgrade.ts";
import {createApp} from "./src/api/app.ts";
import {mkdtempSync,rmSync,writeFileSync} from "node:fs";
import {join} from "node:path";
const directory=mkdtempSync("/tmp/migrate-oracle-");let seq=0;
const result:Record<string,unknown>={};
const records=[{id:"a",title:"原文🙂",status:"todo",created_at:"2017-01-01",updated_at:"2019-01-01"},{id:"b",title:"进行中",status:"doing",created_at:"2018-01-01",updated_at:"2020-01-01"},{id:"c",title:"完成",status:"done",created_at:"2019-01-01",updated_at:"2021-01-01"}];
function create(rows:any[]=records){const path=join(directory,`${++seq}.db`),db=new Database(path);db.exec("CREATE TABLE tasks(id TEXT,title TEXT,status TEXT,created_at TEXT,updated_at TEXT); PRAGMA user_version=1");for(const r of rows)db.query("INSERT INTO tasks VALUES(?,?,?,?,?)").run(r.id,r.title,r.status,r.created_at,r.updated_at);db.close();return path;}
function snapshot(path:string){const db=new Database(path);try{return {version:db.query("PRAGMA user_version").get(),schema:db.query("SELECT type,name,sql FROM sqlite_master WHERE name NOT LIKE 'sqlite_%' ORDER BY name").all(),rows:db.query("SELECT * FROM tasks ORDER BY id").all()};}finally{db.close();}}
async function group(name:string,fn:()=>Promise<unknown>|unknown){try{result[name]=await fn();}catch(e){result[name]={error:String(e)};}}
async function cli(args:string[]){const p=Bun.spawn(["bun","src/cli.ts",...args],{stdout:"pipe",stderr:"pipe"});const timer=setTimeout(()=>p.kill("SIGKILL"),15000);try{return {code:await p.exited,out:await new Response(p.stdout).text(),err:await new Response(p.stderr).text()};}finally{clearTimeout(timer);}}
await group("normal",()=>{const path=create(),first=migrate(path),before=snapshot(path),second=migrate(path),after=snapshot(path);return {first,second,before,after};});
await group("unique",()=>{const path=create();migrate(path);const db=new Database(path);let rejected=false;try{try{db.query("INSERT INTO tasks(id,title,status,created_at,updated_at,deleted_at) VALUES(?,?,?,?,?,NULL)").run("a","duplicate","open","x","y");}catch{rejected=true;}return {rejected,count:(db.query("SELECT COUNT(*) AS n FROM tasks").get() as any).n};}finally{db.close();}});
await group("empty",()=>{const path=create([]);return {summary:migrate(path),snapshot:snapshot(path)};});
await group("dry",()=>{const path=create(),before=snapshot(path),summary=migrate(path,{dryRun:true});return {before,summary,after:snapshot(path)};});
await group("rollback",()=>{return (["after_copy","before_commit"] as const).map(stage=>{const path=create(),before=snapshot(path);let threw=false;try{migrate(path,{fail:s=>{if(s===stage)throw Error("injected");}});}catch{threw=true;}const after=snapshot(path);let recovered:unknown;try{recovered=migrate(path);}catch(e){recovered={error:String(e)};}return {stage,threw,before,after,recovered,final:snapshot(path)};});});
await group("invalid",()=>{const variants=[[{...records[0],status:"unknown"}],[records[0],records[0]],[{...records[0],id:""}],[{...records[0],title:null}]];return variants.flatMap(rows=>[false,true].map(dryRun=>{const path=create(rows),before=snapshot(path);let threw=false;try{migrate(path,{dryRun});}catch{threw=true;}return {dryRun,threw,before,after:snapshot(path)};}));});
await group("version",()=>[0,3].map(version=>{const path=create(),db=new Database(path);db.exec(`PRAGMA user_version=${version}`);db.close();const before=snapshot(path);let threw=false;try{migrate(path);}catch{threw=true;}return {threw,before,after:snapshot(path)};}));
await group("compat",async()=>{const path=create();migrate(path);const db=new Database(path);const app=createApp(db),server=Bun.serve({hostname:"127.0.0.1",port:0,fetch:app});try{const legacy=await (await fetch(new URL("tasks",server.url))).json(),v2=await (await fetch(new URL("v2/tasks",server.url))).json();const a=await cli(["export",path]),b=await cli(["export",path,"--v2"]);db.query("UPDATE tasks SET deleted_at=? WHERE id=?").run("2026-01-01","b");const hiddenOld=await (await fetch(new URL("tasks",server.url))).json(),hiddenNew=await (await fetch(new URL("v2/tasks",server.url))).json();return {legacy,v2,cliOld:{code:a.code,value:JSON.parse(a.out)},cliNew:{code:b.code,value:JSON.parse(b.out)},hiddenOld,hiddenNew};}finally{server.stop(true);db.close();}});
await group("concurrent",async()=>{const path=create(),worker=join(directory,"worker.ts");writeFileSync(worker,`import{migrate}from"/task/src/migrations/upgrade.ts";console.log("READY");for await(const _ of Bun.stdin.stream()){console.log(JSON.stringify(migrate(process.argv[2]!)));break;}`);
const children=Array.from({length:2},()=>Bun.spawn(["bun",worker,path],{stdin:"pipe",stdout:"pipe",stderr:"pipe"}));const readers=children.map(c=>c.stdout.getReader());const heads=await Promise.all(readers.map(r=>r.read()));for(let i=0;i<2;i++)if(!new TextDecoder().decode(heads[i]!.value).includes("READY"))throw Error("worker not ready");for(const c of children){c.stdin.write("go\n");c.stdin.end();}
const replies=await Promise.all(children.map(async(c,i)=>{let text="";while(true){const part=await readers[i]!.read();if(part.done)break;text+=new TextDecoder().decode(part.value);}return {code:await c.exited,value:JSON.parse(text),err:await new Response(c.stderr).text()};}));return {replies,snapshot:snapshot(path)};});
await group("cli",async()=>{const path=create(),dry=await cli(["migrate",path,"--dry-run"]),before=snapshot(path),run=await cli(["migrate",path]),again=await cli(["migrate",path]);const bad=create([{...records[0],status:"bad"}]),failed=await cli(["migrate",bad]);return {dry:{code:dry.code,value:JSON.parse(dry.out)},before,run:{code:run.code,value:JSON.parse(run.out)},again:{code:again.code,value:JSON.parse(again.out)},failed:{code:failed.code,stderr:!!failed.err},bad:snapshot(bad)};});
console.log(JSON.stringify(result));rmSync(directory,{recursive:true,force:true});
