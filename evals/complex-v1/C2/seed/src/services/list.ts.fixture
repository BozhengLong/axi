import type {Database} from "bun:sqlite";
import {rows} from "../storage/tasks.ts";
import {version} from "../storage/version.ts";
import {legacy} from "../format/legacy.ts";
export function list(db:Database,v2=false) {
  if(v2)throw Error(version(db)<2?"migration_required":"v2_not_implemented");
  return rows(db).map(legacy);
}
