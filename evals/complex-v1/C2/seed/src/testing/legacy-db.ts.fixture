import {Database} from "bun:sqlite";
import type {Row} from "../domain/types.ts";
export const sample:Row[]=[{id:"a",title:"准备中文🙂",status:"todo",created_at:"2020-01-02T00:00:00Z",updated_at:"2021-02-03T00:00:00Z"},{id:"b",title:"review",status:"doing",created_at:"2020-01-02T00:00:00Z",updated_at:"2022-03-04T00:00:00Z"},{id:"z",title:"finished",status:"done",created_at:"2020-01-02T00:00:00Z",updated_at:"2023-04-05T00:00:00Z"}];
export function createV1(path:string,data:Row[]=sample){const db=new Database(path);try{db.exec("CREATE TABLE tasks(id TEXT,title TEXT,status TEXT,created_at TEXT,updated_at TEXT); PRAGMA user_version=1");for(const r of data)db.query("INSERT INTO tasks VALUES(?,?,?,?,?)").run(r.id,r.title,r.status,r.created_at,r.updated_at);}finally{db.close();}}
